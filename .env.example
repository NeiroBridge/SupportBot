# Telegram
TELEGRAM_BOT_TOKEN=
# Опционально: Cloudflare Worker, если api.telegram.org недоступен с сервера
TELEGRAM_API_URL=
# Закрытый канал или группа, куда падают заявки. Пример: -1001234567890
OPERATOR_CHAT_ID=

# ProxyAPI (OpenAI-совместимый шлюз)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Хранилище сессий
SQLITE_PATH=data/sessions.db

LOG_LEVEL=INFO
